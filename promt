数据结构定义:

/* 函数Schema定义 */
typedef struct {
    int   schema_id;
    char  name[64];
    char  description[256];
    char  parameters_json[512];     /* JSON Schema格式 */
    int   required_params[8];
    char  returns_schema[256];
    int   enabled;
    int   call_count;
    int   success_count;
} func_schema_t;

/* 函数调用请求 */
typedef struct {
    int   call_id;
    char  name[64];
    char  arguments_json[256];
    int   status;                   /* PENDING/EXECUTING/DONE/ERROR */
    int   created_at;
    int   timeout_ms;
    int   retry_count;
} func_call_t;

/* 函数调用结果 */
typedef struct {
    int   call_id;
    char  output[1024];
    char  error[256];
    int   execution_time_ms;
    int   status;                   /* SUCCESS/ERROR/TIMEOUT */
    int   timestamp;
} func_result_t;

/* 调用统计 */
typedef struct {
    int   total_calls;
    int   success_calls;
    int   error_calls;
    int   avg_latency_ms;
    int   max_latency_ms;
    int   min_latency_ms;
} func_stats_t;

API函数列表:

/* Schema管理 */
int fc_register(func_schema_t* schema);
int fc_unregister(int schema_id);
int fc_update_schema(int schema_id, func_schema_t* schema);
func_schema_t* fc_get_schema(int schema_id);
func_schema_t* fc_find_schema(char* name);
func_schema_t* fc_list_schemas(void);

/* 函数调用 */
int fc_call(char* name, char* arguments_json);  /* 返回call_id */
func_result_t* fc_get_result(int call_id);
int fc_batch_call(func_call_t* calls, int count);
func_result_t* fc_execute_direct(char* name, char* args);  /* 同步执行 */

/* 参数验证 */
int fc_validate_args(func_schema_t* schema, char* arguments_json);
char* fc_get_validation_errors(func_schema_t* schema, char* arguments_json);

/* 调用管理 */
int fc_cancel_call(int call_id);
int fc_retry_call(int call_id);
func_call_t* fc_get_call_history(int limit);
func_call_t* fc_get_pending_calls(void);

/* 统计 */
func_stats_t* fc_get_stats(void);
