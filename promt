### 步骤3: 尝试编译 (15分钟)
```bash
# 编译第一个模块
MOD=$(head -1 /tmp/unbuilt.txt)
clang --target=wasm32-unknown-unknown -Oz -nostdlib -fno-builtin \
    -Wl,--no-entry -Wl,--export=shell_entry \
    modules/$MOD/src/*.c \
    -o modules/$MOD/$MOD.wasm 2>&1 | head -20

# 检查是否成功
ls -lh modules/$MOD/$MOD.wasm 2>/dev/null && echo "✓ 成功" || echo "✗ 失败"
```

### 步骤4: 批量修复 (1小时)
```bash
# 批量编译所有未编译模块
SUCCESS=0
FAIL=0
for MOD in $(cat /tmp/unbuilt.txt); do
    clang --target=wasm32-unknown-unknown -Oz -nostdlib -fno-builtin \
        -Wl,--no-entry -Wl,--export=shell_entry \
        modules/$MOD/src/*.c \
        -o modules/$MOD/$MOD.wasm 2>/dev/null
    if [ $? -eq 0 ]; then
        SUCCESS=$((SUCCESS+1))
        echo "✓ $MOD"
    else
        FAIL=$((FAIL+1))
        echo "✗ $MOD"
    fi
done
echo "成功: $SUCCESS, 失败: $FAIL"
```

