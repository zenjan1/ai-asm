### Q2: 如何建立测试框架?

**问题**: 当前无测试覆盖,代码质量无法保证

**解决方案**:
```bash
# 1. 创建目录结构
mkdir -p tests/{kernel,wasm,integration,benchmarks}

# 2. 内核单元测试
cat > tests/kernel/test_buddy.c << 'EOF'
#include <assert.h>
extern void buddy_init(void);
extern void* buddy_alloc(int order);
extern void buddy_free(void* ptr, int order);

void test_basic() {
    buddy_init();
    void* p = buddy_alloc(0);
    assert(p != NULL);
    buddy_free(p, 0);
}

void test_exhaustion() {
    buddy_init();
    void* ptrs[100];
    int count = 0;
    for (int i = 0; i < 100; i++) {
        ptrs[i] = buddy_alloc(0);
        if (!ptrs[i]) break;
        count++;
    }
    for (int i = 0; i < count; i++) buddy_free(ptrs[i], 0);
}
EOF

# 3. WASM Host测试
cat > tests/wasm/test_host.c << 'EOF'
#include <assert.h>
extern void* host_alloc(int size, int align);
extern void host_free(void* ptr);

void test_alloc_free() {
    void* p = host_alloc(1024, 8);
    assert(p != NULL);
    host_free(p);
}
EOF

# 4. 测试运行器
cat > tests/run_tests.sh << 'EOF'
#!/bin/bash
echo "=== AI-ASM Test Suite ==="
echo "编译测试..."
clang -c tests/kernel/test_buddy.c -o /tmp/test_buddy.o 2>/dev/null && echo "✓ kernel" || echo "✗ kernel"
clang -c tests/wasm/test_host.c -o /tmp/test_host.o 2>/dev/null && echo "✓ wasm" || echo "✗ wasm"
echo "测试完成!"
EOF
chmod +x tests/run_tests.sh

# 5. 运行
./tests/run_tests.sh
```

