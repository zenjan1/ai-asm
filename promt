/*
 * WASM多线程测试应用
 */

extern void* wasm_thread_pool_init();
extern int wasm_thread_pool_submit(void* func, void* arg);
extern void wasm_thread_pool_wait();

extern void wasm_mutex_init();
extern void wasm_mutex_lock();
extern void wasm_mutex_unlock();

extern int host_print(const char* msg, int len);

void worker_thread(void* arg) {
    int id = *(int*)arg;
    char msg[50];
    snprintf(msg, sizeof(msg), "Thread %d executing\n", id);
    host_print(msg, strlen(msg));
}

int counter = 0;
void counter_thread(void* arg) {
    for (int i = 0; i < 100; i++) {
        wasm_mutex_lock();
        counter++;
        wasm_mutex_unlock();
    }
}

int shell_entry() {
    host_print("=== WASM Threading Test ===\n", 26);

    // 测试线程池
    host_print("Test 1: Thread pool\n", 23);
    wasm_thread_pool_init();

    int ids[4] = {1, 2, 3, 4};
    for (int i = 0; i < 4; i++) {
        wasm_thread_pool_submit(worker_thread, &ids[i]);
    }

    wasm_thread_pool_wait();
    host_print("All threads completed\n", 23);

    // 测试互斥锁
    host_print("\nTest 2: Mutex\n", 15);
    wasm_mutex_init();
    counter = 0;

    wasm_thread_pool_submit(counter_thread, NULL);
    wasm_thread_pool_submit(counter_thread, NULL);

    wasm_thread_pool_wait();

    char msg[50];
    snprintf(msg, sizeof(msg), "Final counter: %d (expected 200)\n", counter);
    host_print(msg, strlen(msg));

    host_print("\n=== Test Complete ===\n", 23);
    return 0;
}
EOF
