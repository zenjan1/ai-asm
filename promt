## 四、立即可执行的任务

### 快速诊断脚本
```bash
#!/bin/bash
# diagnose_unbuilt.sh - 诊断未编译模块

echo "=== 未编译模块诊断 ==="

# 列出未编译模块
ls modules/ | comm -23 - <(find modules -name "*.wasm" -printf '%h\n' | xargs -I{} basename {} | sort -u) > /tmp/unbuilt.txt

echo "未编译模块数量: $(wc -l < /tmp/unbuilt.txt)"
echo ""
echo "前10个未编译模块:"
head -10 /tmp/unbuilt.txt

echo ""
echo "检查源文件完整性:"
for mod in $(head -5 /tmp/unbuilt.txt); do
    echo "  $mod: $(ls modules/$mod/src/*.c 2>/dev/null | wc -l) 个C文件"
done

echo ""
echo "尝试编译第一个模块:"
mod=$(head -1 /tmp/unbuilt.txt)
echo "  模块: $mod"
clang --target=wasm32-unknown-unknown -Oz -nostdlib -fno-builtin \
    -Wl,--no-entry -Wl,--export=shell_entry \
    modules/$mod/src/*.c \
    -o /tmp/test.wasm 2>&1 | head -5
```

