#### 任务1.3: 完善wasm_thread多线程功能

**新增内核模块**:
```bash
# 线程池管理
cat > kernel/wasm_thread_pool.asm << 'EOF'
/* WASM线程池管理 */
.global wasm_thread_pool_init
.global wasm_thread_pool_submit
.global wasm_thread_pool_wait

wasm_thread_pool_init:
    /* 初始化线程池 */
    ret

wasm_thread_pool_submit:
    /* 提交任务到线程池 */
    ret

wasm_thread_pool_wait:
    /* 等待所有任务完成 */
    ret
EOF

# 互斥锁
cat > kernel/wasm_mutex.asm << 'EOF'
/* WASM互斥锁 */
.global wasm_mutex_init
.global wasm_mutex_lock
.global wasm_mutex_unlock

wasm_mutex_init:
    ret

wasm_mutex_lock:
    ret

wasm_mutex_unlock:
    ret
EOF
```

**测试应用**:
```bash
mkdir -p modules/wasm_thread_test/src
cat > modules/wasm_thread_test/src/main.c << 'EOF'
#include <wasm_thread.h>

void* worker(void* arg) {
    int id = *(int*)arg;
    host_print("Thread %d running\n", id);
    return NULL;
}

int shell_entry() {
    wasm_thread_t t1, t2;
    int id1 = 1, id2 = 2;

    wasm_thread_create(&t1, worker, &id1);
    wasm_thread_create(&t2, worker, &id2);

    wasm_thread_join(t1);
    wasm_thread_join(t2);

    host_print("All threads completed\n");
    return 0;
}
EOF
```

