### Q3: wasm_thread如何使用?

**问题**: v46.0引入了wasm_thread,但功能不完整

**当前状态**: 基础多线程支持,缺少同步原语

**解决方案**:
```bash
# 1. 添加线程池
cat > kernel/wasm_thread_pool.asm << 'EOF'
.arch armv8-a
.data
pool_size: .word 0
task_queue: .space 512
queue_head: .word 0
queue_tail: .word 0

.text
.global wasm_thread_pool_init
.global wasm_thread_pool_submit
.global wasm_thread_pool_wait

wasm_thread_pool_init:
    mov x0, #0
    str x0, pool_size
    str x0, queue_head
    str x0, queue_tail
    ret

wasm_thread_pool_submit:
    // x0=任务函数, x1=参数
    ldr x2, queue_tail
    lsl x2, x2, #3
    adr x3, task_queue
    add x3, x3, x2
    stp x0, x1, [x3]
    ldr x2, queue_tail
    add x2, x2, #1
    str x2, queue_tail
    mov x0, #0
    ret

wasm_thread_pool_wait:
    ldr x0, queue_head
    ldr x1, queue_tail
    cmp x0, x1
    bne wasm_thread_pool_wait
    ret
EOF

# 2. 添加互斥锁
cat > kernel/wasm_mutex.asm << 'EOF'
.arch armv8-a
.data
mutex_locked: .word 0

.text
.global wasm_mutex_init
.global wasm_mutex_lock
.global wasm_mutex_unlock

wasm_mutex_init:
    mov x0, #0
    str x0, mutex_locked
    ret

wasm_mutex_lock:
    mov x0, #1
    mov x1, #0
    adr x2, mutex_locked
    casa x0, x1, [x2]
    cbz x0, lock_acquired
    wfe
    b wasm_mutex_lock
lock_acquired:
    mov x0, #0
    ret

wasm_mutex_unlock:
    mov x0, #0
    adr x1, mutex_locked
    str x0, [x1]
    sev
    ret
EOF

# 3. 编译
as -march=armv8-a kernel/wasm_thread_pool.asm -o build/wasm_thread_pool.o
as -march=armv8-a kernel/wasm_mutex.asm -o build/wasm_mutex.o

# 4. 测试应用
mkdir -p modules/wasm_thread_test/src
cat > modules/wasm_thread_test/src/main.c << 'EOF'
extern void wasm_thread_pool_init();
extern int wasm_thread_pool_submit(void* func, void* arg);
extern void wasm_thread_pool_wait();
extern int host_print(const char* msg, int len);

void worker(void* arg) {
    int id = *(int*)arg;
    char msg[50];
    snprintf(msg, sizeof(msg), "Thread %d\n", id);
    host_print(msg, strlen(msg));
}

int shell_entry() {
    wasm_thread_pool_init();
    int ids[4] = {1, 2, 3, 4};
    for (int i = 0; i < 4; i++) {
        wasm_thread_pool_submit(worker, &ids[i]);
    }
    wasm_thread_pool_wait();
    host_print("All done\n", 10);
    return 0;
}
EOF
```

