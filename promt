mkdir -p release/v3.0/modules
cp build/kernel.elf release/v3.0/
cp modules/*/*.wasm release/v3.0/modules/
cp README.md CHANGELOG.md ROADMAP.md release/v3.0/
tar -czf release/aiasm-v3.0.tar.gz v3.0/
```

### 4. Git标签
