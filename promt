## 快速开始

```bash
# 1. 检查未编译模块
ls modules/ | comm -23 - <(find modules -name "*.wasm" -printf '%h\n' | xargs -I{} basename {} | sort -u) | wc -l

# 2. 创建测试目录
mkdir -p tests/{kernel,wasm,integration,benchmarks}

# 3. 编译新内核模块
as -march=armv8-a kernel/wasm_thread_pool.asm -o build/wasm_thread_pool.o
as -march=armv8-a kernel/wasm_mutex.asm -o build/wasm_mutex.o

# 4. 重新链接内核
ld -T kernel/linker.ld -nostdlib -N build/*.o -o build/kernel.elf

# 5. 运行测试
./tests/run_tests.sh
```

