## ⚡ 执行命令

```bash
# 1. 诊断未编译模块
ls modules/ | comm -23 - <(find modules -name "*.wasm" -printf '%h\n' | xargs -I{} basename {} | sort -u)

# 2. 批量编译
for mod in $(cat /tmp/unbuilt.txt); do
  clang --target=wasm32-unknown-unknown -Oz -nostdlib -fno-builtin \
    -Wl,--no-entry -Wl,--export=shell_entry \
    modules/$mod/src/*.c -o modules/$mod/$mod.wasm
done

# 3. 验证
echo "编译率: $(find modules -name "*.wasm" | wc -l)/$(ls modules/ | wc -l)"
```

